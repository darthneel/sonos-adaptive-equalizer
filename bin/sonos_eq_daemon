#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require_relative "../lib/sonos_eq/daemon"
require_relative "../lib/sonos_eq/config"

options = {
  config_path: File.expand_path("../config/settings.yml", __dir__),
  once: false,
  dry_run: false,
  validate_config: false
}

OptionParser.new do |parser|
  parser.banner = "Usage: bin/sonos_eq_daemon [options]"
  parser.on("-c", "--config PATH", "Path to YAML config") { |v| options[:config_path] = v }
  parser.on("--once", "Run one poll cycle then exit") { options[:once] = true }
  parser.on("--dry-run", "Run one cycle without writing to speakers or persistent state") { options[:dry_run] = true }
  parser.on("--validate-config", "Validate configuration and exit") { options[:validate_config] = true }
end.parse!

if options[:validate_config]
  SonosEq::Config.load(options[:config_path])
  puts "Configuration is valid: #{File.expand_path(options[:config_path])}"
  exit
end

SonosEq::Daemon.new(options[:config_path], once: options[:once], dry_run: options[:dry_run]).run
