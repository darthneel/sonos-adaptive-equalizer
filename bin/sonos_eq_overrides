#!/usr/bin/env ruby
# frozen_string_literal: true

ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)
require "bundler/setup"
require_relative "../lib/sonos_eq/override_cli"

begin
  SonosEq::OverrideCli.run(ARGV)
rescue OptionParser::ParseError, SonosEq::Config::Error => e
  warn "Error: #{e.message}"
  exit 1
end
